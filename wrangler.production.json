{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_WORKER_NAME",
  "account_id": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "binding": "ASSETS" },
  "vars": { "DEPLOYMENT_MODE": "public-only" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_PRODUCTION_DATABASE_NAME",
    "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_UUID",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "PHOTOS",
    "bucket_name": "REPLACE_WITH_PRIVATE_PRODUCTION_BUCKET_NAME"
  }]
}
