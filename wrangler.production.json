{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prathik-photo-blog",
  "account_id": "cadeb687b90d1d35c346c6ccf59e357f",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "binding": "ASSETS" },
  "vars": { "DEPLOYMENT_MODE": "public-only" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "prathik-photoblog-prod",
    "database_id": "c7f4de62-e4cf-4d3c-a39f-e036d2c16688",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "PHOTOS",
    "bucket_name": "prathik-photos-prod"
  }]
}
